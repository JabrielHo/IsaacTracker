{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isaactracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // Every minute. Free plan allows 1-minute granularity.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // No public URL. Cron triggers don't need a route, and the status page in
  // src/index.ts leaks a Riot ID and a "currently playing" flag to anyone who
  // finds the hostname — workers.dev subdomains do get scanned. Every hit would
  // also cost a KV read and an invocation out of the same free-tier budgets the
  // cron depends on.
  //
  // These must live here, not just in the dashboard: turning the route off in
  // the Cloudflare UI without setting this key means the next `wrangler deploy`
  // silently switches it back on.
  //
  // preview_urls covers the versioned "<version>-tft-tracker.<sub>.workers.dev"
  // hostnames, which are a separate door from the main route.
  "workers_dev": false,
  "preview_urls": false,

  // Run `npx wrangler kv namespace create TRACKER` and paste the id it prints.
  "kv_namespaces": [
    {
      "binding": "TRACKER",
      "id": "6ef3bfd3a90c47bc8641364a585d4344"
    }
  ],

  "vars": {
    "RIOT_PLATFORM": "sg2",
    "PLAYERS": "audioizzzaac#98k",
    "ANNOUNCE_GAME_START": "true",
    "TRACK_QUEUE": "double_up"
  },

  "observability": {
    "enabled": true
  }

  // Secrets are NOT stored here. Set them with:
  //   npx wrangler secret put RIOT_API_KEY
  //   npx wrangler secret put TELEGRAM_BOT_TOKEN
  //   npx wrangler secret put TELEGRAM_CHAT_ID
}
